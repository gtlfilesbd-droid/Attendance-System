# =============================================================================
# Genesis Employee Attendance - Environment Variables
# Copy to .env and fill in values. Do not commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
SECRET_KEY=your-django-secret-key-change-in-production
DB_PASSWORD=your-secure-database-password

# -----------------------------------------------------------------------------
# Database
# Use either DATABASE_URL (single URL) or individual DB_* variables.
# -----------------------------------------------------------------------------
# Option A: Single URL (postgres://user:password@host:port/dbname)
# DATABASE_URL=postgres://postgres:yourpassword@db:5432/genesis_attendance_db

# Option B: Individual variables (used when DATABASE_URL is not set)
DB_NAME=genesis_attendance_db
DB_USER=postgres
DB_HOST=db
DB_PORT=5432

# -----------------------------------------------------------------------------
# Django (include your Web PC IP for app/dashboard access, e.g. 192.168.1.104)
# -----------------------------------------------------------------------------
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,192.168.1.104

# -----------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call the API)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://192.168.1.104:8000,https://yourdomain.com

# -----------------------------------------------------------------------------
# Optional: Google Maps (for map widgets or geocoding)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Celery (Redis)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# JWT (minutes). Access=1440 => 24h; Refresh=43200 => 30 days.
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME=1440
JWT_REFRESH_TOKEN_LIFETIME=43200

# -----------------------------------------------------------------------------
# Email (optional)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
